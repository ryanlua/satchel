@derive "./ThemeTokens";

-- General
$StyleCategory = "Tokens";

-- Layout
-- useSlotMetrics reads these to size the hotbar and inventory.
-- Hotbar padding uses the same gap, so row width is count * (slot + gap) + gap.
$SlotGap = 5px;
$SlotSize = udim2 (60px, 60px);
$TenFootSlotSize = udim2 (100px, 100px);

-- Hints
$HintFontFace = $FontFace;
$HintTenFootInterfaceTextSize = $TenFootInterfaceTextSize;
$HintTextColor = $TextColor;
$HintTextSize = $TextSize;

-- Search
$SearchAnchorPoint = vec2 (0, 0);
$SearchBackgroundColor = $BackgroundColor;
$SearchBackgroundTransparency = 0.2;
$SearchCornerRadius = $SmallCornerRadius;
$SearchFontFace = $FontFace;
$SearchFrameSize = udim2 (100%, 35px);
$SearchPadding = 8px;
$SearchPlaceholderColor = #B2B2B2;
$SearchPosition = udim2 (0px, 0px);
$SearchSize = udim2 (100%, 30px);
$SearchStrokeColor = #FFFFFF;
$SearchStrokeTransparency = 0.8;
$SearchTextColor = $TextColor;
$SearchTextSize = $TextSize;
$SearchTextStrokeTransparency = $TextStrokeTransparency;

-- Slots
$SlotBackgroundColor = #191B1D;
$SlotBackgroundTransparency = 0.3;
$SlotCornerRadius = $SmallCornerRadius;
$SlotEquipStrokeColor = #335FFF;
$SlotEquipStrokePosition = Enum.BorderStrokePosition.Center;
$SlotEquipStrokeThickness = 4;
$SlotFontFace = $FontFace;
$SlotIconCornerRadius = 0px;
$SlotNumberFontFace = $FontFace;
$SlotNumberPadding = 0px;
$SlotNumberPaddingBottom = $SlotNumberPadding;
$SlotNumberPaddingLeft = $SlotNumberPadding;
$SlotNumberPaddingRight = $SlotNumberPadding;
$SlotNumberPaddingTop = $SlotNumberPadding;
$SlotNumberStrokeColor = $TextStrokeColor;
$SlotNumberStrokeTransparency = $TextStrokeTransparency;
$SlotNumberTextColor = $TextColor;
$SlotNumberTextSize = $SmallTextSize;
$SlotPadding = 5px;
$SlotPressStrokeColor = #FFFFFF;
$SlotPressStrokeThickness = 2;
$SlotTextColor = $TextColor;
$SlotTextSize = $TextSize;
$SlotTextStrokeColor = $TextStrokeColor;
$SlotTextStrokeTransparency = $TextStrokeTransparency;
$SlotUnlockBackgroundColor = $SlotBackgroundColor;

-- Inventory
$InventoryBackgroundColor = $BackgroundColor;
$InventoryBackgroundTransparency = 0.3;
$InventoryCornerRadius = $CornerRadius;
$InventoryPadding = 5px;
$InventoryScrollbarColor = #D0D8FA;
$InventoryScrollbarGutter = 13px;

-- Tooltip
$TooltipBackgroundColor = #262830;
$TooltipBackgroundTransparency = 0;
$TooltipCornerRadius = $SmallCornerRadius;
$TooltipFontFace = $FontFace;
$TooltipPadding = 4px;
$TooltipShadowBlurRadius = 4px;
$TooltipShadowEnabled = true;
$TooltipShadowOffset = udim2 (0px, 2px);
$TooltipShadowSpread = udim2 (0px, 1px);
$TooltipShadowTransparency = 0.5;
$TooltipTextColor = $TextColor;
$TooltipTextSize = $SmallTextSize;
