@derive "./BaseTokens";

$StyleCategory = "Themes";

-- General
$BackgroundColor = #1F1F1F;
$BackgroundTransparency = 0.5;
$CornerRadius = 0px;
$FontFace = font ("SourceSansPro", :Regular);
$SmallCornerRadius = 0px;
$SmallTextSize = 14;
$TenFootInterfaceSmallTextSize = 24;
$TenFootInterfaceTextSize = 24;
$TextSize = 14;
$TextStrokeTransparency = 1;

-- Hints
$HintFontFace = font ("SourceSansPro", :Bold);
$HintTenFootInterfaceTextSize = 36;
$HintTextSize = 24;

-- Search
$SearchAnchorPoint = vec2 (1, 0);
$SearchBackgroundColor = #5E5E5E;
$SearchBackgroundTransparency = 0;
$SearchPadding = 0px;
$SearchPlaceholderColor = #FFFFFF;
$SearchPosition = udim2 (100%, 0px);
$SearchSize = udim2 (190px, 30px);
$SearchStrokeTransparency = 1;
$SearchTextSize = 24;

-- Slots
$SlotBackgroundColor = #1F1F1F;
$SlotBackgroundTransparency = $BackgroundTransparency;
$SlotEquipStrokeColor = #5A8EE9;
$SlotEquipStrokePosition = Enum.BorderStrokePosition.Inner;
$SlotEquipStrokeThickness = 5;
$SlotNumberPaddingLeft = -4px;
$SlotNumberPaddingTop = -8px;
$SlotPadding = 6px;
$SlotUnlockBackgroundColor = #313131;

-- Inventory
$InventoryBackgroundTransparency = $BackgroundTransparency;

-- Tooltip
$TooltipBackgroundColor = #666666;
$TooltipPadding = 2px;
$TooltipShadowEnabled = false;
