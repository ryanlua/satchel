@derive "./DefaultTheme";

-- Gamepad hints stay hidden until that input is preferred, unless tagged Visible.
@macro GamepadHintVisible {
	Visible = false;

	@PreferredInputGamepad,.Visible {
		@priority 1;
		Visible = true;
	}
}

.InventoryHint {
	AutomaticSize = :X;
	BackgroundTransparency = 1;
	GamepadHintVisible!();
	Size = udim2 (0px, 40px);

	>ImageLabel {
		AnchorPoint = vec2 (0, 0.5);
		BackgroundTransparency = 1;
		Position = udim2 (0px, 50%);
		ScaleType = :Fit;
		Size = udim2 (37px, 37px);

		::UIAspectRatioConstraint {
			AspectRatio = 1.5;
		}
	}

	>TextLabel {
		AnchorPoint = vec2 (0, 0.5);
		AutomaticSize = :X;
		BackgroundTransparency = 1;
		FontFace = $HintFontFace;
		Position = udim2 (42px, 50%);
		TextColor3 = $HintTextColor;
		TextSize = $HintTextSize;
	}
}

TextButton.Slot {
	AutoButtonColor = false;
	BackgroundColor3 = $SlotBackgroundColor;
	BackgroundTransparency = $SlotBackgroundTransparency;
	FontFace = $SlotFontFace;
	Size = $SlotSize;
	TextColor3 = $SlotTextColor;
	TextSize = $SlotTextSize;
	TextStrokeColor3 = $SlotTextStrokeColor;
	TextStrokeTransparency = $SlotTextStrokeTransparency;
	TextTruncate = :SplitWord;

	-- Equip and press can show together, so they are separate strokes.
	>UIStroke {
		ApplyStrokeMode = :Border;
		Enabled = false;

		.EquipStroke {
			Color = $SlotEquipStrokeColor;
			LineJoinMode = :Round;
			Thickness = $SlotEquipStrokeThickness;
		}

		.PressStroke {
			BorderStrokePosition = :Inner;
			Color = $SlotPressStrokeColor;
			Thickness = $SlotPressStrokeThickness;
		}
	}

	.Equipped {
		@priority 1;

		>UIStroke.EquipStroke {
			Enabled = true;
		}
	}

	:Hover {
		@priority 1;

		>.Tooltip {
			Visible = true;
		}
	}

	.SwapSource {
		@priority 2;

		>UIStroke.PressStroke {
			Enabled = true;
		}
	}

	.Unlocked {
		@priority 1;
		BackgroundColor3 = $SlotUnlockBackgroundColor;
		BackgroundTransparency = 0;

		:Press {
			>UIStroke.PressStroke {
				Enabled = true;
			}
		}
	}

	.Dragging {
		@priority 1;

		>UIStroke.PressStroke {
			Enabled = true;
		}

		>.Tooltip {
			Visible = true;
		}
	}

	.Placeholder {
		@priority 2;
		BackgroundTransparency = 1;
		TextTransparency = 1;
		TextStrokeTransparency = 1;

		>ImageLabel {
			ImageTransparency = 1;
		}

		>TextLabel {
			Visible = false;
		}

		>UIStroke {
			Enabled = false;
		}
	}

	CornerRadius! ($SlotCornerRadius);

	:Press {
		@priority 1;

		>.Tooltip {
			Visible = true;
		}
	}

	-- SlotNumber and ToolTip are both labels. Hide them here;
	-- keyboard input reveals the number, and :Hover/:Press/.Dragging reveal the tooltip.
	>TextLabel {
		Size = udim2 (0px, 0px);
		Visible = false;

		.SlotNumber {
			BackgroundTransparency = 1;
			FontFace = $SlotNumberFontFace;
			Size = udim2 (100%, 100%);
			TextColor3 = $SlotNumberTextColor;
			TextSize = $SlotNumberTextSize;
			TextStrokeColor3 = $SlotNumberStrokeColor;
			TextStrokeTransparency = $SlotNumberStrokeTransparency;
			TextXAlignment = :Left;
			TextYAlignment = :Top;
			Visible = false;

			@PreferredInputKeyboardAndMouse,.Visible {
				@priority 1;
				Visible = true;
			}
		}
	}

	>ImageLabel {
		BackgroundTransparency = 1;
		Size = udim2 (100%, 100%);

		CornerRadius! ($SlotIconCornerRadius);
	}

	Padding! ($SlotPadding);
}

.Backpack {
	Active = true;
	AutomaticSize = :XY;
	BackgroundTransparency = 1;

	::UIListLayout {
		SortOrder = :LayoutOrder;
	}
}

.Hotbar {
	AutomaticSize = :XY;
	BackgroundTransparency = 1;
	LayoutOrder = 1;

	::UIListLayout {
		FillDirection = :Horizontal;
		Padding = $SlotGap;
		SortOrder = :LayoutOrder;
		VerticalAlignment = :Center;
	}

	Padding! (0px, $SlotGap);
}

.HotbarHints {
	AnchorPoint = vec2 (0.5, 1);
	AutomaticSize = :XY;
	BackgroundTransparency = 1;
	Position = udim2 (50%, 100%);

	::UIListLayout {
		FillDirection = :Horizontal;
		SortOrder = :LayoutOrder;
		VerticalAlignment = :Bottom;
	}
}

.InventoryHints {
	AutomaticSize = :Y;
	BackgroundTransparency = 1;

	::UIListLayout {
		SortOrder = :LayoutOrder;
	}
}

-- Width is set in App from useSlotMetrics so hints wrap to the hotbar width.
.Hints {
	AutomaticSize = :Y;
	BackgroundTransparency = 1;

	::UIListLayout {
		FillDirection = :Horizontal;
		HorizontalAlignment = :Center;
		HorizontalFlex = Enum.UIFlexAlignment.SpaceEvenly;
		Padding = 5px;
		Wraps = true;
	}
}

TextLabel.Tooltip {
	AnchorPoint = vec2 (0.5, 1);
	AutomaticSize = :XY;
	BackgroundColor3 = $TooltipBackgroundColor;
	BackgroundTransparency = $TooltipBackgroundTransparency;
	FontFace = $TooltipFontFace;
	Position = udim2 (50%, -10px);
	Size = udim2 (0px, 0px);
	TextColor3 = $TooltipTextColor;
	TextSize = $TooltipTextSize;

	Padding! ($TooltipPadding);
	CornerRadius! ($TooltipCornerRadius);

	::UIShadow {
		BlurRadius = $TooltipShadowBlurRadius;
		Offset = $TooltipShadowOffset;
		Spread = $TooltipShadowSpread;
		Transparency = $TooltipShadowTransparency;
	}
}

TextBox.Searchbar {
	BackgroundColor3 = $SearchBackgroundColor;
	BackgroundTransparency = $SearchBackgroundTransparency;
	ClearTextOnFocus = false;
	ClipsDescendants = true;
	FontFace = $SearchFontFace;
	PlaceholderColor3 = $SearchPlaceholderColor;
	PlaceholderText = "Search";
	Size = $SearchSize;
	TextColor3 = $SearchTextColor;
	TextSize = $SearchTextSize;
	TextStrokeTransparency = $SearchTextStrokeTransparency;
	TextXAlignment = :Left;

	::UIStroke {
		ApplyStrokeMode = :Border;
		Color = $SearchStrokeColor;
		Transparency = $SearchStrokeTransparency;
	}

	CornerRadius! ($SearchCornerRadius);

	>ImageButton {
		AnchorPoint = vec2 (1, 0.5);
		BackgroundTransparency = 1;
		Image = "rbxasset://textures/ui/InspectMenu/x.png";
		Position = udim2 (100%, 50%);
		Selectable = false;
		Size = udim2 (100%, 100%);

		::UIAspectRatioConstraint {
			AspectRatio = 1;
		}
	}

	Padding! ($SearchPadding);
}

.HotbarHint {
	BackgroundTransparency = 1;
	GamepadHintVisible!();
	Size = $SlotSize;

	>ImageLabel {
		AnchorPoint = vec2 (0.5, 0.5);
		BackgroundTransparency = 1;
		Position = udim2 (50%, 50% - 5px);
		ScaleType = :Fit;
		Size = udim2 (100%, 100%);

		::UIAspectRatioConstraint {
			AspectRatio = 2;
		}
	}
}

-- Width is set in Inventory from useSlotMetrics. Height follows the search row and the scrolling frame.
.Inventory {
	AutomaticSize = :Y;
	BackgroundColor3 = $InventoryBackgroundColor;
	BackgroundTransparency = $InventoryBackgroundTransparency;

	CornerRadius! ($InventoryCornerRadius);

	::UIListLayout {
		Padding = 1px;
	}

	>ScrollingFrame {
		AutomaticCanvasSize = Enum.AutomaticSize.Y;
		BackgroundTransparency = 1;
		BorderSizePixel = 0;
		CanvasSize = udim2 (0px, 0px);
		ElasticBehavior = :Always;
		ScrollBarImageColor3 = $InventoryScrollbarColor;
		ScrollBarThickness = 8;
		ScrollingDirection = :Y;
		Selectable = false;

		::UIListLayout {
			FillDirection = :Horizontal;
			Padding = $SlotGap;
			SortOrder = :LayoutOrder;
			Wraps = true;
		}

		Padding! ($InventoryPadding);
	}

	>#SearchFrame {
		BackgroundTransparency = 1;
		Size = $SearchFrameSize;

		Padding! ($InventoryPadding, $InventoryPadding, 0px);
	}
}

.TenFootInterface {
	@priority 1;

	>> TextButton.Slot {
		Size = $TenFootSlotSize;
		TextSize = $TenFootInterfaceTextSize;

		>TextLabel.SlotNumber {
			TextSize = $TenFootInterfaceSmallTextSize;
		}
	}

	>> TextLabel.Tooltip {
		TextSize = $TenFootInterfaceSmallTextSize;
	}

	>> #SearchFrame {
		Visible = false;
	}

	>> .HotbarHint {
		Size = $TenFootSlotSize;
	}

	>> .InventoryHint {
		Size = udim2 (0px, 60px);

		>ImageLabel {
			Size = udim2 (56px, 56px);
		}

		>TextLabel {
			Position = udim2 (62px, 50%);
			TextSize = $HintTenFootInterfaceTextSize;
		}
	}
}
